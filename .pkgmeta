# Настройки упаковки для BigWigsMods/packager (CurseForge и GitHub Releases)
package-as: Polyglot

# Модули языков лежат внутри основного аддона, а в архиве должны быть отдельными папками
# на одном уровне с Polyglot (так их видит игра).
move-folders:
  Polyglot/Modules/Polyglot_enUS: Polyglot_enUS
  Polyglot/Modules/Polyglot_ruRU: Polyglot_ruRU
  Polyglot/Modules/Polyglot_deDE: Polyglot_deDE
  Polyglot/Modules/Polyglot_frFR: Polyglot_frFR
  Polyglot/Modules/Polyglot_esES: Polyglot_esES
  Polyglot/Modules/Polyglot_esMX: Polyglot_esMX
  Polyglot/Modules/Polyglot_itIT: Polyglot_itIT
  Polyglot/Modules/Polyglot_ptBR: Polyglot_ptBR
  Polyglot/Modules/Polyglot_koKR: Polyglot_koKR
  Polyglot/Modules/Polyglot_zhCN: Polyglot_zhCN
  Polyglot/Modules/Polyglot_zhTW: Polyglot_zhTW

# Эти файлы нужны только разработчику и в архив для игроков не попадают
ignore:
  - tools
  - tests
  - docs
  - README.md
  - data_build.txt
  - .github
  - .gitignore
  - .gitattributes
